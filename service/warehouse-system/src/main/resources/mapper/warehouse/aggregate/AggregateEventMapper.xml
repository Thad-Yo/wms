<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xiaoyai.warehouse.mapper.AggregateEventMapper">
    <resultMap type="AggregateEvent" id="AggregateEventResult">
        <result property="eventId" column="event_id"/>
        <result property="identityId" column="identity_id"/>
        <result property="rfidCode" column="rfid_code"/>
        <result property="materialId" column="material_id"/>
        <result property="eventType" column="event_type"/>
        <result property="eventName" column="event_name"/>
        <result property="eventTime" column="event_time"/>
        <result property="locationName" column="location_name"/>
        <result property="longitude" column="longitude"/>
        <result property="latitude" column="latitude"/>
        <result property="operatorId" column="operator_id"/>
        <result property="operatorName" column="operator_name"/>
        <result property="actionName" column="action_name"/>
        <result property="deviceId" column="device_id"/>
        <result property="deviceCode" column="device_code"/>
        <result property="deviceType" column="device_type"/>
        <result property="warehouseId" column="warehouse_id"/>
        <result property="warehouseName" column="warehouse_name"/>
        <result property="fromWarehouseId" column="from_warehouse_id"/>
        <result property="fromWarehouseName" column="from_warehouse_name"/>
        <result property="toWarehouseId" column="to_warehouse_id"/>
        <result property="toWarehouseName" column="to_warehouse_name"/>
        <result property="weight" column="weight"/>
        <result property="vehicleNo" column="vehicle_no"/>
        <result property="sourceReceiptType" column="source_receipt_type"/>
        <result property="sourceReceiptId" column="source_receipt_id"/>
        <result property="sourceReceiptNo" column="source_receipt_no"/>
        <result property="rawPayload" column="raw_payload"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <select id="selectAggregateEventList" parameterType="AggregateEvent" resultMap="AggregateEventResult">
        select event_id, identity_id, rfid_code, material_id, event_type, event_name, event_time,
               location_name, longitude, latitude, operator_id, operator_name, action_name,
               device_id, device_code, device_type, warehouse_id, warehouse_name,
               from_warehouse_id, from_warehouse_name, to_warehouse_id, to_warehouse_name,
               weight, vehicle_no, source_receipt_type, source_receipt_id, source_receipt_no,
               raw_payload, create_by, create_time, remark
        from aggregate_event
        <where>
            <if test="identityId != null">and identity_id = #{identityId}</if>
            <if test="rfidCode != null and rfidCode != ''">and rfid_code = #{rfidCode}</if>
            <if test="eventType != null and eventType != ''">and event_type = #{eventType}</if>
            <if test="warehouseId != null">and warehouse_id = #{warehouseId}</if>
        </where>
        order by event_time asc, event_id asc
    </select>
</mapper>
